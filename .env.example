PINECONE_API_KEY=
PINECONE_HOST=
PINECONE_INDEX=
OPENAI_API_KEY=
LLM_API_KEY=
PINECONE_INDEX_LEDNINGSSYSTEM=

# Optional — set to "anthropic" to use Claude for chat completions. Defaults to openai.
LLM_PROVIDER=
# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional Claude model override (defaults to claude-sonnet-4-5)
ANTHROPIC_MODEL=

# Supabase — required for /reindex endpoints
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (defaults to "knowledge-base" if omitted)
SUPABASE_BUCKET=knowledge-base
