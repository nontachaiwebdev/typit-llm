{
  "openapi": "3.0.0",
  "info": {
    "title": "Typit LLM",
    "description": "RAG-based LLM API powered by LangChain and Pinecone",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://4d71-2a02-1406-27a-8fa5-c812-3f5e-d96f-c92c.ngrok-free.app",
      "description": "Production server"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "security": [{ "ApiKeyAuth": [] }],
  "paths": {
    "/chat": {
      "post": {
        "summary": "Ask a question",
        "description": "Send a message and get an answer based on ingested documents",
        "operationId": "chat",
        "security": [{ "ApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["message"],
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "The user's question"
                  }
                }
              },
              "example": {
                "message": "Vad är arbetsmiljöpolicyn?"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string",
                      "description": "The LLM's answer based on the documents"
                    }
                  }
                },
                "example": {
                  "answer": "Arbetsmiljöpolicyn säger att..."
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
